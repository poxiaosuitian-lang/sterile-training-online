{$SITE_ADDRESS} {
    encode gzip zstd
    @playerWeb path /play /play/*
    respond @playerWeb 404
    redir / /api/v1/admin 302
    reverse_proxy api:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}

# Optional independent game domain; no game hostname is hard-coded.
import /etc/caddy/game-sites/*.caddy
