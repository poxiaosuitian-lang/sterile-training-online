# Use long random hex strings for these secrets. Keep this file private.
POSTGRES_PASSWORD=replace_with_random_hex_password
JWT_SECRET=replace_with_random_hex_secret_at_least_32_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_password_at_least_12_characters
# Use your domain for automatic HTTPS, e.g. training.example.com
# :80 is for local verification only.
SITE_ADDRESS=:80
# Optional: distinct player domain. Set before enabling game-sites/player.caddy.
GAME_SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443
